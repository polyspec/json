    "@humanwhocodes/momoa": "3.3.13",
    "@polyspec/kit": "https://github.com/polyspec/kit/releases/download/v0.0.102/polyspec-kit-0.0.102.tgz",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.5",
    "ajv": "8.20.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-string": "4.0.0",
    "micromark-extension-gfm": "3.0.0",
    "smol-toml": "1.9.1",
    "typescript": "7.0.2"
