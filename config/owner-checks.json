{
  "schema": 1,
  "comment": "The checks that own each tracked path, read by owner-check of @polyspec/kit: make owner-check runs the owners of the changed paths, never the full suite; make owner-validate, a gate of kit-gates-static, checks this file. ordered-json-test-scripts runs the verifier unit tests (TESTS selects test files) and verify-<language> verifies one implementation.",
  "owners": [
    {
      "paths": [
        "**/*.md",
        "config/documents.json"
      ],
      "targets": [
        "docs-check"
      ]
    },
    {
      "paths": [
        "docs/features.md",
        "docs/features.ko.md",
        "docs/plans/execution/checklist.md",
        "docs/plans/execution/checklist.ko.md"
      ],
      "targets": [
        "ordered-json-test-scripts",
        "docs-check",
        "evidence-check"
      ]
    },
    {
      "paths": [
        "tests/scripts/*.test.mts"
      ],
      "targets": [
        "ordered-json-test-scripts"
      ],
      "variable": "TESTS"
    },
    {
      "paths": [
        "tests/scripts/checkout.mts"
      ],
      "targets": [
        "ordered-json-test-scripts"
      ]
    },
    {
      "paths": [
        "scripts/registry.mts",
        "scripts/reference.mts",
        "scripts/verify.mts",
        "config/implementations.json",
        "examples/official.json",
        "contracts/fixtures/**"
      ],
      "targets": [
        "ordered-json-test-scripts",
        "verify-js",
        "verify-rust",
        "verify-go",
        "verify-php",
        "verify-php-extension",
        "verify-python"
      ]
    },
    {
      "paths": [
        "scripts/records.mts",
        "scripts/json.mts",
        "scripts/present.mts",
        "scripts/schema/*.schema.json",
        "scripts/check-pie.mts",
        ".gitignore",
        "Makefile",
        "tsconfig.json"
      ],
      "targets": [
        "ordered-json-test-scripts",
        "typecheck"
      ]
    },
    {
      "paths": [
        "benchmarks/run.mts"
      ],
      "targets": [
        "ordered-json-test-scripts",
        "typecheck",
        "benchmark-check"
      ]
    },
    {
      "paths": [
        "benchmarks/*.{mjs,php,json}",
        "benchmarks/fixtures/*.json",
        "packages/rust/examples/benchmark.rs",
        "legacy/packages/go/internal/benchmark/*.go"
      ],
      "targets": [
        "benchmark-check"
      ]
    },
    {
      "paths": [
        "external-inputs.json",
        "package.json",
        "composer.json",
        "composer.lock",
        "legacy/packages/js/package.json",
        "legacy/packages/php/composer.json",
        "legacy/packages/php-ext/composer.json",
        "packages/rust/Cargo.toml",
        "legacy/packages/go/go.mod",
        "legacy/packages/python/pyproject.toml"
      ],
      "targets": [
        "ordered-json-test-scripts",
        "release-coverage"
      ]
    },
    {
      "paths": [
        ".github/workflows/*.yml",
        ".github/actions/kit-bootstrap/action.yml"
      ],
      "targets": [
        "ordered-json-test-scripts"
      ]
    },
    {
      "paths": [
        "config/checklist.json",
        "config/owner-checks.json"
      ],
      "targets": [
        "owner-validate",
        "docs-check"
      ]
    },
    {
      "paths": [
        "config/*.json",
        "package.json",
        "package-lock.json"
      ],
      "targets": []
    },
    {
      "paths": [
        "PRINCIPLES.md",
        "AGENTS.md"
      ],
      "targets": [
        "rules-check"
      ]
    },
    {
      "paths": [
        ".editorconfig",
        "config/composer.schema.json",
        "config/cargo.schema.json"
      ],
      "targets": [
        "layout-check"
      ]
    },
    {
      "paths": [
        "config/layout.kit.yml",
        "config/layout.yml"
      ],
      "targets": [
        "layout-check"
      ]
    },
    {
      "paths": [
        "legacy/packages/js/**"
      ],
      "targets": [
        "verify-js",
        "test-js"
      ]
    },
    {
      "paths": [
        "packages/rust/**",
        "contracts/core.json"
      ],
      "targets": [
        "verify-rust",
        "test-rust"
      ]
    },
    {
      "paths": [
        "legacy/packages/go/**"
      ],
      "targets": [
        "verify-go",
        "test-go"
      ]
    },
    {
      "paths": [
        "legacy/packages/php/**"
      ],
      "targets": [
        "verify-php",
        "verify-php-extension",
        "test-php"
      ]
    },
    {
      "paths": [
        "legacy/packages/php-ext/**"
      ],
      "targets": [
        "verify-php-extension",
        "test-php-ext"
      ]
    },
    {
      "paths": [
        "legacy/packages/python/**"
      ],
      "targets": [
        "verify-python",
        "test-python"
      ]
    },
    {
      "paths": [
        "benchmarks/python-parse/*",
        "legacy/packages/python/src/polyspec/ordered_json/__init__.py"
      ],
      "targets": [
        "python-parse-budget"
      ]
    },
    {
      "paths": [
        "config/release.json",
        "CHANGELOG.md",
        "CHANGELOG.ko.md"
      ],
      "targets": [
        "release-coverage"
      ]
    },
    {
      "paths": [
        "scripts/check-evidence.mts",
        "external-inputs.json"
      ],
      "targets": [
        "ordered-json-test-scripts",
        "evidence-check"
      ]
    },
    {
      "paths": [
        "mise.toml",
        ".npmrc",
        "mise.lock",
        ".mise/**",
        ".php-version",
        "rust-toolchain.toml",
        "config/toolchain.json",
        "legacy/packages/go/go.mod",
        "package.json"
      ],
      "targets": [
        "ordered-json-test-scripts"
      ]
    },
    {
      "paths": [
        "config/rebuild.json"
      ],
      "targets": [
        "rebuild-check"
      ]
    },
    {
      "paths": [
        "config/duplication.json"
      ],
      "targets": [
        "duplication-check"
      ]
    },
    {
      "paths": [
        "**/*.ts",
        "**/*.mts",
        "**/*.js",
        "**/*.mjs"
      ],
      "targets": [
        "lint-ts",
        "duplication-check"
      ]
    },
    {
      "paths": [
        "**/*.py"
      ],
      "targets": [
        "lint-python",
        "duplication-check"
      ]
    },
    {
      "paths": [
        "**/*.php"
      ],
      "targets": [
        "lint-php",
        "duplication-check"
      ]
    },
    {
      "paths": [
        "**/*.go"
      ],
      "targets": [
        "lint-go",
        "duplication-check"
      ]
    },
    {
      "paths": [
        "**/*.rs"
      ],
      "targets": [
        "lint-rust",
        "duplication-check"
      ]
    },
    {
      "paths": [
        "legacy/packages/php-ext/**"
      ],
      "targets": [
        "lint-php-ext",
        "duplication-check"
      ]
    },
    {
      "paths": [
        ".oxlintrc.json",
        "knip.json"
      ],
      "targets": [
        "lint-ts"
      ]
    },
    {
      "paths": [
        "phpcs.xml.dist",
        "phpstan.dist.neon"
      ],
      "targets": [
        "lint-php"
      ]
    },
    {
      "paths": [
        "ruff.toml"
      ],
      "targets": [
        "lint-python"
      ]
    },
    {
      "paths": [
        ".golangci.yml"
      ],
      "targets": [
        "lint-go"
      ]
    },
    {
      "paths": [
        "clippy.toml",
        "packages/rust/Cargo.toml"
      ],
      "targets": [
        "lint-rust"
      ]
    },
    {
      "paths": [
        "packages/ts/**",
        "packages/python/**",
        "packages/php-ext/**"
      ],
      "targets": [
        "layout-check"
      ]
    }
  ]
}
