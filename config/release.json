{
  "schema": 1,
  "repositoryUrl": "https://github.com/polyspec/ordered-json",
  "changelog": "CHANGELOG.md",
  "changelogTranslations": [
    "CHANGELOG.ko.md"
  ],
  "packages": [
    {
      "kind": "npm",
      "directory": "packages/js",
      "name": "@polyspec/ordered-json",
      "product": "ordered-json",
      "runtime": "ts"
    },
    {
      "kind": "composer",
      "directory": "packages/php",
      "name": "polyspec/ordered-json",
      "product": "ordered-json",
      "runtime": "php"
    },
    {
      "kind": "composer",
      "directory": "packages/php-ext",
      "name": "polyspec/ordered-json-php-ext",
      "product": "ordered-json",
      "runtime": "php-ext"
    },
    {
      "kind": "wheel",
      "directory": "packages/python",
      "name": "polyspec-ordered-json",
      "product": "ordered-json",
      "runtime": "python"
    }
  ],
  "manifests": {
    "package.json": "version",
    "packages/js/package.json": "archive",
    "composer.json": "version",
    "packages/php/composer.json": "archive",
    "packages/php-ext/composer.json": "archive",
    "packages/rust/Cargo.toml": "git-tag",
    "packages/python/pyproject.toml": "archive"
  },
  "notReleased": {},
  "goModules": {
    "packages/go": "github.com/polyspec/ordered-json/packages/go"
  },
  "annotatedTags": true,
  "packageFiles": [
    "package.json",
    "composer.json",
    "Cargo.toml",
    "pyproject.toml",
    "go.mod",
    "VERSION"
  ],
  "writtenFiles": [
    "config/phpunit/composer.json",
    ".mise/locks/**"
  ]
}
