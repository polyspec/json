  "changes": [
    {
      "id": "change-parse-source",
      "rule": "RQ-026",
      "reason": "RQ-026: JSON text is UTF-8 (RFC 8259 8.1), so one parse of the contract type source takes a text or its bytes; a second entry point per input form or per option is a second API of one rule (P-1)",
      "symbol": "parse",
      "from": {
        "node": "parse(source: string, options?: ParseOptions): Value; parseBytes(bytes: Uint8Array, options?: ParseOptions): Value",
        "python": "parse(source: str, options: ParseOptions | None = None) -> Value; parse_bytes(data, options=None) -> Value",
        "php": "parse(string $source, int $maxDepth = MAX_DEPTH): Value; Value::parse(string $source); Value::parseRejectDuplicates(string $source)",
        "go": "Parse(source string) (Value, error); ParseBytes(source []byte); ParseWithMaxDepth(source string, limit int); ParseRejectDuplicates(source string)"
      },
      "to": "parse"
    },
    {
      "id": "change-offsets",
      "rule": "RQ-026",
      "reason": "RQ-026: every offset counts bytes of the UTF-8 text in every language, so one case has one offset; a text with an unpaired surrogate has no UTF-8 encoding and is refused by the binding (B-3) instead of the core kind unescaped_lone_surrogate",
      "symbol": "parse",
      "from": {
        "node": "ParseError.offset counts UTF-16 units of a text, ParseError.unit is 'utf16' or 'byte'; a lone surrogate of a text is unescaped_lone_surrogate",
        "python": "a lone surrogate of a text is unescaped_lone_surrogate"
      },
      "to": "parse_error.offset"
    },
    {
      "id": "change-parse-options",
      "rule": "RQ-035",
      "reason": "RQ-035, design T-4: the options of parse are one record with one form in every language (P-10)",
      "symbol": "ParseOptions",
      "from": {
        "node": "interface ParseOptions { maxDepth?: number; rejectDuplicates?: boolean }",
        "python": "class ParseOptions(max_depth: int = MAX_DEPTH, reject_duplicates: bool = False)",
        "php": "parse(string $source, int $maxDepth = MAX_DEPTH)",
        "go": "ParseWithMaxDepth(source, limit); ParseRejectDuplicates(source)"
      },
      "to": "parse_options"
    },
    {
      "id": "change-stringify",
      "rule": "RQ-034",
      "reason": "RQ-034: the serializer is the one function stringify and the string hook; compact wrote the same text under a second name",
      "symbol": "stringify, compact",
      "from": {
        "node": "stringify(value: Value): string",
        "python": "stringify(value) -> str; Value.compact() -> str",
        "php": "stringify(Value $value, bool $compact = true): string; Value::compact(): string",
        "go": "Stringify(value Value) (string, error); Value.Compact() (string, error)"
      },
      "to": "stringify"
    },
    {
      "id": "change-html-safe",
      "rule": "RQ-031",
      "reason": "RQ-031: the HTML-safe output of template FUN-27 is an option of the one JSON serializer, so no library writes JSON a second time",
      "symbol": "stringify_options",
      "from": {
        "node": "none",
        "python": "none",
        "php": "none",
        "go": "none"
      },
      "to": "stringify_options"
    },
    {
      "id": "change-string-value",
      "rule": "RQ-027",
      "reason": "RQ-027, P-3: a string with an unpaired surrogate has no Unicode text; returning a lone surrogate gives the caller a text that no UTF-8 output holds, and string_units keeps it losslessly",
      "symbol": "Value.string_value",
      "from": {
        "node": "stringValue(): string returns lone surrogates",
        "python": "string_value() -> str returns lone surrogates"
      },
      "to": "value.string_value"
    },
    {
      "id": "change-string-constructor",
      "rule": "RQ-028",
      "reason": "RQ-028: the string constructor escapes only what RFC 8259 section 7 requires and writes the rest as UTF-8, as JSON.stringify does; a text that is no UTF-8 is refused by the binding (B-3)",
      "symbol": "Value.string",
      "from": {
        "node": "Value.string(text) writes \\u escapes for non-ASCII and keeps lone surrogates",
        "python": "Value.string(text) writes \\u escapes for non-ASCII and keeps lone surrogates",
        "php": "Value::string($text) writes \\u escapes for non-ASCII",
        "go": "String(text) writes \\u escapes for non-ASCII"
      },
      "to": "value.string"
    },
    {
      "id": "change-from-units",
      "rule": "RQ-028",
      "reason": "RQ-028, RQ-029: a string with unpaired surrogates is built from code units in every language, the text of a language being UTF-8 at the boundary (RQ-026)",
      "symbol": "Value.from_units",
      "from": {
        "node": "none: Value.string(text) took lone surrogates"
      },
      "to": "value.from_units"
    },
    {
      "id": "change-from-float",
      "rule": "RQ-030",
      "reason": "RQ-030: the token of a float is the one rule of the core, which template and crudui also use",
      "symbol": "Value.from_float",
      "from": {
        "node": "none",
        "python": "none",
        "php": "none",
        "go": "none"
      },
      "to": "value.from_float"
    },
    {
      "id": "change-accessors",
      "rule": "RQ-032",
      "reason": "RQ-032, P-2: an access of another kind is a failure with the kind wrong_kind, never an absence, and lookup is absent only for a missing name; the accessors that a failure ends are methods (design I-3)",
      "symbol": "Value accessors",
      "from": {
        "node": "readonly members: ReadonlyMap<string, Value>; readonly items: readonly Value[]; readonly keys: readonly Value[]; get(key): Value | undefined",
        "python": "members() -> Mapping[str, Value]; items() -> tuple[Value, ...]; get(key) -> Value | None",
        "php": "members(): array; items(): array; get(string $key): ?Value",
        "go": "Members() (OrderedMap, error); Get(key) *Value; GetUnits(units) *Value"
      },
      "to": "value.members"
    },
    {
      "id": "change-ordered-map",
      "rule": "RQ-009",
      "reason": "RQ-009, RQ-002: the members of an object are an OrderedMap whose keys are values in every language, so a key with an unpaired surrogate is not lost; object takes an OrderedMap (design T-2 has no union of input forms)",
      "symbol": "OrderedMap, Value.object",
      "from": {
        "node": "Value.object(entries: Iterable<[string | Value, Value]>)",
        "python": "Value.object(entries: Mapping | Iterable[tuple])",
        "php": "Value::object(array $members); members(): array<string, Value>",
        "go": "OrderedMap.Set(key, value); Keys(); Object(map)"
      },
      "to": "ordered_map"
    },
    {
      "id": "change-errors",
      "rule": "E-2",
      "reason": "design E-2, E-3, plan B-4: every error is a library class of its category with kind and status, the parse rejections parse_error with offset; a host class with an added kind and a class of two categories (PHP ArgumentError) do not let a caller catch by category",
      "symbol": "errors",
      "from": {
        "node": "class ParseError extends SyntaxError { offset; unit; kind }; TypeError and RangeError with kind",
        "python": "class ParseError(ValueError) with kind and offset; TypeError and ValueError with kind",
        "php": "ParseError extends InvalidArgumentException; ArgumentError extends InvalidArgumentException; UsageError extends LogicException; public readonly string $kind",
        "go": "type Error interface { Kind() ErrorKind; Offset() int; Message() string }"
      },
      "to": "parse_error"
    },
    {
      "id": "change-host-hooks",
      "rule": "RQ-034",
      "reason": "RQ-020, RQ-034: Go encoding/json rewrites <, > and & of the text of MarshalJSON, so the hook cannot keep the contract bytes and refuses in every language; Python has no hook and json.dumps refuses with its own error",
      "symbol": "MarshalJSON, JSONEncoder",
      "from": {
        "go": "Value.MarshalJSON writes the compact text; Value.UnmarshalJSON parses",
        "python": "class JSONEncoder(json.JSONEncoder) refuses in default()"
      },
      "to": "value.to_json"
    },
    {
      "id": "change-kind-enum",
      "rule": "T-6",
      "reason": "design T-6: an enum has one form in every language; the kind of a value is the enum Kind",
      "symbol": "Value.kind",
      "from": {
        "node": "enum Kind; readonly kind: Kind",
        "php": "kind(): string",
        "go": "const ObjectKind ... NullKind Kind"
      },
      "to": "kind"
    },
    {
      "id": "change-php-package",
      "rule": "P-1",
      "reason": "design P-1: the PHP package of the extension is polyspec/<repository> (polyspec/json) of type php-ext, and the classes are those of the contract",
      "symbol": "Polyspec\\Json",
      "from": {
        "php": "Composer polyspec/ordered-json (PHP) and PIE polyspec/ordered-json-php-ext (C)"
      },
      "to": "functions"
    },
    {
      "id": "change-wasm-init",
      "rule": "P-5",
      "reason": "design P-5: the browser loads the WASM binding, which initializes asynchronously with init()",
